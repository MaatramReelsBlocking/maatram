rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ══ Maatram security model ══════════════════════════════════════════
       There is no admin console on the site any more. The only privileged
       address below can take a sports listing down; it can NOT write to
       anyone's user document. Moderation (ban / delete a user) is done from
       the Firebase console, which runs as the Admin SDK and bypasses rules.

       Anything the client can write is pinned to an explicit key allowlist.
       That is what stops an email address, a phone number, or any other
       personal field ever landing in a document every signed-in student can
       read. Adding a field means editing this file first — on purpose.
       ════════════════════════════════════════════════════════════════════ */

    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    /* takedown rights for the public sports board only */
    function isListingModerator() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email in ['maatram97@gmail.com'];
    }

    function old()  { return resource.data; }
    function neu()  { return request.resource.data; }
    function touched(keys) {
      return neu().diff(old()).affectedKeys().hasAny(keys);
    }
    function changed() { return neu().diff(old()).affectedKeys(); }

    /* ── points pacing ──
       A gain must stamp awardAt with the server clock, and may be at most
       1 point per 6 seconds since the previous gain (so +100 needs 10 min).
       Penalties and profile edits never touch awardAt. A devtools loop can
       earn ~600 points an hour at most instead of 100 per write. */
    function gain() { return neu().points - old().get('points', 0); }
    function paced() {
      return (gain() <= 0 && !touched(['awardAt']))
          || (gain() > 0
              && neu().awardAt == request.time
              && gain() * 6 <= (request.time - old().get('awardAt', timestamp.value(0))).seconds());
    }

    /* Everything a browser is ever allowed to write on a user document.
       NOTE the absence of: email, phone, any contact field, any moderation
       field. A key that is not on this list is rejected outright. */
    function writableKeys() {
      return ['name','photo','points','lifetime','lastLogin','cycle','awardAt'];
    }
    function safeText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    /* Google profile photos only: a free-form URL on a doc every student
       loads would let anyone plant a tracking pixel on the leaderboard. */
    function photoOk(v) {
      return v == '' || (v is string && v.size() <= 500
                         && v.matches('^https://[a-z0-9.-]+\\.googleusercontent\\.com/.*'));
    }
    /* A board cycle is always a real month id, never '' (that would reopen
       the first-ever-roll branch below). */
    function cycleOk(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}$'); }

    match /users/{uid} {

      /* The leaderboard lists every player, so any signed-in user can read
         these documents. They are safe to read precisely because the write
         allowlist above keeps personal data out of them. */
      allow read: if request.auth != null;

      allow create: if isOwner(uid)
                    && neu().keys().hasOnly(writableKeys())
                    && safeText(neu().name, 40)
                    && neu().points is int
                    && neu().points >= 0
                    && neu().points <= 100
                    && (!('photo' in neu()) || photoOk(neu().photo))
                    && (!('lastLogin' in neu()) || neu().lastLogin is timestamp)
                    && (!('cycle' in neu()) || cycleOk(neu().cycle))
                    && (!('lifetime' in neu()) || neu().lifetime == 0)
                    && (!('awardAt' in neu()) || neu().awardAt == request.time);

      allow update: if isOwner(uid)
                    && old().get('banned', false) != true   // a banned account is frozen
                    && neu().points is int
                    && neu().points >= 0
                    && neu().points <= 3000                 // hard ceiling on a month
                    && (!('name'  in changed()) || safeText(neu().name, 40))
                    && (!('photo' in changed()) || photoOk(neu().photo))
                    && (!('lastLogin' in changed()) || neu().lastLogin is timestamp)
                    && (
                         // normal play: one award or one penalty per write.
                         // cycle and lifetime move only in the two roll branches.
                         (   changed().hasOnly(writableKeys())
                          && !touched(['lifetime', 'cycle'])
                          && neu().points >= old().get('points', 0) - 100
                          && neu().points <= old().get('points', 0) + 100
                          && paced())

                         // monthly roll: archive this month, then zero
                      || (   changed().hasOnly(writableKeys()
                                 .concat(['m_' + old().get('cycle', 'x')]))
                          && old().get('cycle', '') != ''
                          && cycleOk(neu().cycle)
                          && neu().points == 0
                          && neu().cycle != old().get('cycle', '')
                          && neu().lifetime == old().get('lifetime',0) + old().get('points',0)
                          && neu().get('m_' + old().get('cycle', 'x'), -1) is int
                          && neu().get('m_' + old().get('cycle', 'x'), -1) == old().get('points', 0)
                          && !touched(['awardAt']))

                         // first-ever roll (gate.js): stamp the cycle only. lifetime holds
                         // archived past months, so it stays as it is (0 if missing) and
                         // this month's points stay in points -- never counted twice.
                      || (   changed().hasOnly(['cycle', 'lifetime'])
                          && old().get('cycle', '') == ''
                          && cycleOk(neu().cycle)
                          && neu().get('lifetime', 0) == old().get('lifetime', 0))
                       );

      /* Deleting an account is a console job, not a browser job. */
      allow delete: if false;
    }

    /* ── sports events ──
       Any signed-in user lists one. The author can take their own listing
       down; the moderator address can take any listing down.
       url is scheme-checked here as well as in the page, so a stored
       "javascript:" link can never reach the database in the first place. */
    match /events/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && neu().keys().hasOnly(['title','sport','city','date','venue','org','url','by','createdAt'])
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && (!('createdAt' in neu()) || neu().createdAt is int)
                    && (!('sport' in neu()) || safeText(neu().sport, 40))
                    && (!('city'  in neu()) || safeText(neu().city, 60))
                    && (!('venue' in neu()) || neu().venue is string && neu().venue.size() <= 120)
                    && (!('org'   in neu()) || neu().org is string && neu().org.size() <= 80)
                    && (!('url'   in neu()) || neu().url == ''
                        || (neu().url is string && neu().url.size() <= 300
                            && neu().url.matches('^https?://.*')));
      allow update: if false;                       // a listing is never edited in place
      allow delete: if isListingModerator()
                    || (request.auth != null && resource.data.by == request.auth.uid);
    }

    /* Linked devices (api/link.js): one Hard Lock for the website, phone app and Chrome extension.
       Anyone holding a code can read it or start a lock on it (that is what linking means), but a
       running lock can only be extended — never shortened or cancelled — and is capped at 90 min.
       Codes cannot be listed. */
    match /links/{code} {
      allow get:    if code.matches('^[A-HJ-NP-Z2-9]{8}$');
      allow list, delete: if false;
      allow create, update: if code.matches('^[A-HJ-NP-Z2-9]{8}$')
                    && request.resource.data.keys().hasOnly(['end','minutes','by','at'])
                    && request.resource.data.end is int
                    && request.resource.data.minutes is int
                    && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 90
                    && request.resource.data.end > request.time.toMillis()
                    && request.resource.data.end <= request.time.toMillis() + 91 * 60 * 1000
                    && request.resource.data.by in ['web','phone','chrome']
                    && (resource == null
                        || resource.data.end <= request.time.toMillis()
                        || request.resource.data.end >= resource.data.end);
    }

    /* Nothing else is reachable from a browser. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
