rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── the Maatram admin account ──
       Add another address to this list to make someone else an admin.
       Nothing else in the site grants admin rights. */
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in ['maatram97@gmail.com'];
    }

    function old()  { return resource.data; }
    function neu()  { return request.resource.data; }
    function touched(keys) {
      return neu().diff(old()).affectedKeys().hasAny(keys);
    }

    /* ── points pacing ──
       A gain must stamp awardAt with the server clock, and may be at most
       1 point per 6 seconds since the previous gain (so +100 needs 10 min).
       Penalties and profile edits never touch awardAt. A devtools loop can
       now earn ~600 points an hour at most instead of 100 per write. */
    function gain() { return neu().points - old().get('points', 0); }
    function paced() {
      return (gain() <= 0 && !touched(['awardAt']))
          || (gain() > 0
              && neu().awardAt == request.time
              && gain() * 6 <= (request.time - old().get('awardAt', timestamp.value(0))).seconds());
    }

    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.points is int
                    && request.resource.data.points >= 0
                    && request.resource.data.points <= 100
                    && !('banned'   in request.resource.data)
                    && !('kickAt'   in request.resource.data)
                    && !('lifetime' in request.resource.data)
                    && (!('awardAt' in request.resource.data) || request.resource.data.awardAt == request.time);

      /* ── admin can write anything on any user doc ── */
      allow update: if isAdmin();

      /* ── a normal user editing their own doc ── */
      allow update: if request.auth != null && request.auth.uid == uid
                    && old().get('banned', false) != true   // banned accounts are frozen
                    && neu().points is int
                    && neu().points >= 0
                    && neu().points <= 3000           // hard ceiling on a month
                    // moderation fields are untouchable from the client
                    && !touched(['banned','kickAt','bannedReason','isAdmin'])
                    && (
                         // normal play: one award or one penalty per write
                         (   !touched(['lifetime'])
                          && neu().points >= old().get('points', 0) - 100
                          && neu().points <= old().get('points', 0) + 100
                          && paced())
                         // monthly roll: archive this month, then zero
                      || (   neu().points == 0
                          && neu().cycle != old().get('cycle', '')
                          && neu().lifetime == old().get('lifetime',0) + old().get('points',0)
                          && !touched(['awardAt']))
                         // first-ever roll (gate.js): adopt lifetime, points untouched
                      || (   old().get('cycle', '') == ''
                          && neu().cycle is string
                          && neu().points == old().get('points', 0)
                          && !touched(['awardAt'])
                          && (   (neu().lifetime == old().get('lifetime', 0) && old().get('lifetime', 0) >= old().get('points', 0))
                              || (neu().lifetime == old().get('points', 0)   && old().get('points', 0) >  old().get('lifetime', 0))))
                       );

      allow delete: if isAdmin();
    }

    /* sports events: any signed-in user lists one, only an admin takes it down */
    match /events/{id} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.date is string;
      allow update, delete: if isAdmin();
    }

    /* admin audit trail: every ban / kick / points edit is written here.
       Readable and writable by admins only. */
    match /admin_log/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
